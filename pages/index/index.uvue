<template>
  <view class="control-container">
    <!-- 顶部状态栏 -->
    <view class="status-bar">
      <text class="connection-status" :class="{ connected: isConnected }">
        {{ isConnected ? '已连接' : '未连接' }}
      </text>
      <text class="battery-status">100%</text>
    </view>

    <!-- 主控制区域 -->
    <view class="main-controls">
      <!-- 左侧圆形摇杆（核心修改区域） -->
      <view class="left-control">
        <view class="joystick-container"
          ref="joystickContainer"
          @touchstart="startJoystick"
          @touchmove="moveJoystick"
          @touchend="endJoystick"
          @touchcancel="endJoystick">
          <!-- 滑块（允许部分超出容器，中心点限制在容器内） -->
          <view class="joystick" :style="joystickStyle"></view>
        </view>
      </view>

      <!-- 右侧十字控制（保持不变） -->
      <view class="right-control">
        <view class="d-pad-container"
          ref="dPadContainer"
          @touchstart="startDPad"
          @touchmove="moveDPad"
          @touchend="endDPad"
          @touchcancel="endDPad">
          <view class="d-pad-base vertical"></view>
          <view class="d-pad-base horizontal"></view>
          <view class="d-pad-joystick" :style="dPadStyle" v-if="isDPadDragging || (dPadOffset.x || dPadOffset.y)"></view>
        </view>
      </view>
    </view>

    <!-- 快捷功能按钮 -->
    <view class="quick-actions">
      <view class="action-btn" @click="emergencyStop">
        <text class="action-icon">⏹</text>
        <text class="action-text">急停</text>
      </view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      isConnected: true,
      // 左侧摇杆状态（核心参数）
      joystickOffset: { x: 0, y: 0 }, // 滑块中心点偏移量
      isJoystickDragging: false,
      containerRadius: 0, // 容器半径（rpx）
      containerCenter: { x: 0, y: 0 }, // 容器中心点（px）
      
      // 右侧十字键状态
      dPadOffset: { x: 0, y: 0 },
      isDPadDragging: false,
      dPadRange: 60,
      dPadCenter: { x: 0, y: 0 }
    };
  },
  computed: {
    joystickStyle() {
      // 滑块位置 = 容器中心 + 偏移量（确保中心点从容器中心开始计算）
      return {
        transform: `translate(${this.joystickOffset.x}rpx, ${this.joystickOffset.y}rpx)`
      };
    },
    dPadStyle() {
      return {
        left: `${this.dPadCenter.x + this.dPadOffset.x}rpx`,
        top: `${this.dPadCenter.y + this.dPadOffset.y}rpx`
      };
    }
  },
  onLoad() {
    this.$nextTick(() => {
      this.initJoystickParams(); // 初始化左侧摇杆参数
      this.calcDPadCenter();
    });
  },
  methods: {
    // 初始化左侧摇杆关键参数
    initJoystickParams() {
      const query = uni.createSelectorQuery().in(this);
      query.select('.joystick-container').fields({ size: true, rect: true }, (res) => {
        // 1. 容器中心点（px，用于触摸位置计算）
        this.containerCenter = {
          x: res.left + res.width / 2,
          y: res.top + res.height / 2
        };
        
        // 2. 容器半径（rpx，用于限制滑块中心点范围）
        const screenWidth = uni.getSystemInfoSync().screenWidth;
        this.containerRadius = (res.width / 2) * (750 / screenWidth); // 转换为rpx
      }).exec();
    },
    
    // 左侧摇杆触摸开始（起始点为容器圆心）
    startJoystick(e) {
      this.isJoystickDragging = true;
      // 初始位置强制为圆心
      this.joystickOffset = { x: 0, y: 0 };
      this.moveJoystick(e); // 立即响应触摸位置
    },
    
    // 左侧摇杆移动逻辑（核心修改）
    moveJoystick(e) {
      if (!this.isJoystickDragging) return;
      
      // 1. 计算触摸点相对容器中心的偏移（px）
      const touchX = e.touches[0].clientX;
      const touchY = e.touches[0].clientY;
      const offsetPx = {
        x: touchX - this.containerCenter.x,
        y: touchY - this.containerCenter.y
      };
      
      // 2. 转换为rpx单位
      const screenWidth = uni.getSystemInfoSync().screenWidth;
      const offsetRpx = {
        x: offsetPx.x * (750 / screenWidth),
        y: offsetPx.y * (750 / screenWidth)
      };
      
      // 3. 限制滑块中心点在容器范围内（核心逻辑）
      const distance = Math.sqrt(offsetRpx.x **2 + offsetRpx.y** 2);
      if (distance > this.containerRadius) {
        // 超出范围时，将中心点拉回容器边缘
        const scale = this.containerRadius / distance;
        this.joystickOffset = {
          x: offsetRpx.x * scale,
          y: offsetRpx.y * scale
        };
      } else {
        // 未超出范围时，直接使用触摸位置作为中心点
        this.joystickOffset = offsetRpx;
      }
    },
    
    // 左侧摇杆触摸结束（复位到圆心）
    endJoystick() {
      this.isJoystickDragging = false;
      this.joystickOffset = { x: 0, y: 0 };
    },
    
    // 右侧十字键控制（保持不变）
    calcDPadCenter() {
      const query = uni.createSelectorQuery().in(this);
      query.select('.d-pad-container').fields({ size: true }, (res) => {
        const screenWidth = uni.getSystemInfoSync().screenWidth;
        this.dPadCenter = {
          x: (res.width / 2) * 750 / screenWidth,
          y: (res.height / 2) * 750 / screenWidth
        };
      }).exec();
    },
    
    startDPad(e) {
      this.isDPadDragging = true;
      this.moveDPad(e);
    },
    
    moveDPad(e) {
      if (!this.isDPadDragging) return;
      
      const containerRect = this.$refs.dPadContainer.getBoundingClientRect();
      const centerPx = {
        x: containerRect.left + containerRect.width / 2,
        y: containerRect.top + containerRect.height / 2
      };
      
      const screenWidth = uni.getSystemInfoSync().screenWidth;
      const touchOffsetRpx = {
        x: (e.touches[0].clientX - centerPx.x) * 750 / screenWidth,
        y: (e.touches[0].clientY - centerPx.y) * 750 / screenWidth
      };
      
      let offsetX = 0;
      let offsetY = 0;
      
      if (Math.abs(touchOffsetRpx.x) > Math.abs(touchOffsetRpx.y)) {
        offsetX = Math.max(-this.dPadRange, Math.min(this.dPadRange, touchOffsetRpx.x));
        offsetY = 0;
      } else {
        offsetY = Math.max(-this.dPadRange, Math.min(this.dPadRange, touchOffsetRpx.y));
        offsetX = 0;
      }
      
      this.dPadOffset = { x: offsetX, y: offsetY };
    },
    
    endDPad() {
      this.isDPadDragging = false;
      this.dPadOffset = { x: 0, y: 0 };
    },
    
    emergencyStop() {
      uni.showModal({
        title: '紧急停止',
        content: '确定要停止机器人所有动作吗？',
        confirmText: '停止',
        cancelText: '取消',
        success: (res) => {
          if (res.confirm) {
            this.joystickOffset = { x: 0, y: 0 };
            this.dPadOffset = { x: 0, y: 0 };
            this.isJoystickDragging = false;
            this.isDPadDragging = false;
            uni.showToast({ title: '已停止', icon: 'success' });
          }
        }
      });
    }
  }
};
</script>

<style scoped>
/* 左侧摇杆样式优化（确保滑块可以部分超出容器） */
.joystick-container {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  position: relative;
  touch-action: none;
  overflow: visible; /* 允许滑块超出容器显示 */
}

.joystick {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%); /* 初始位置为容器中心 */
  touch-action: none;
  transition: transform 0.05s ease-out;
}

/* 其他样式保持不变 */
.control-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #1a1a1a;
  color: #ffffff;
  overflow: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  font-size: 28rpx;
}

.connection-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.1);
}

.connection-status.connected {
  color: #34c759;
}

.main-controls {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 50rpx 0;
}

.left-control, .right-control {
  width: 240rpx;
  height: 240rpx;
}

.d-pad-container {
  width: 220rpx;
  height: 220rpx;
  background-color: #1a1a1a;
  position: relative;
  touch-action: none;
}

.d-pad-base {
  background-color: rgba(255, 255, 255, 0.2);
  position: absolute;
}

.vertical {
  width: 60rpx;
  height: 100%;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.horizontal {
  width: 100%;
  height: 60rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.d-pad-joystick {
  width: 50rpx;
  height: 50rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  transform: translate(-50%, -50%);
  touch-action: none;
  transition: all 0.05s ease-out;
  z-index: 1;
}

.quick-actions {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.action-btn {
  width: 120rpx;
  height: 120rpx;
  background-color: #ff3b30;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  background-color: #cc0000;
  transform: scale(0.95);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  color: white;
}

.action-text {
  font-size: 24rpx;
  color: white;
}
</style>