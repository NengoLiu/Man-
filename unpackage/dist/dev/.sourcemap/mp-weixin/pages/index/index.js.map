// 主操控页面
<template>
	<view class="control-container">
		<view class="status-bar">
			<text class="connection-status" :class="{ connected: isConnected }">
				{{ isConnected ? '已连接' : '未连接'}}
			</text>
			<text class="battery-status">100%</text>
		</view>
			
		<!-- 控制区域 -->
		<view class="controls-area">
		    <!-- 左侧圆形摇杆容器 -->
		    <view class="left-control"></view>
		    <view class="joystick-container">
				<view class="joystick"></view>
		    </view>
		</view>
		      
		      <!-- 右侧十字控制容器 -->
		<view class="right-control">
			<view class="d-pad-container"
				@touchstart="startDPad" 
				@touchmove="moveDPad" 
				@touchend="endDPad"
				@touchcancel="endDPad"></view>
		    <view class="d-pad-bg">
		        <view class="d-pad-line vertical"></view>
		        <view class="d-pad-line horizontal"></view>
		    </view>
		    <!-- 可滑动的圆形滑块 -->
		    <view class="d-pad-joystick" 
		        :style="{ 
		            left: dPadX + 'px', 
		            top: dPadY + 'px' 
		        }">
			</view>
		</view>
		
		<!-- 快捷功能按钮 -->
		<view class="quick-actions">
		    <view class="action-btn" @click="emergencyStop">
		        <text class="action-icon">⏹</text>
		        <text class="action-text">急停</text>
		    </view>
		</view>
		
		
	</view>
</template>
	
	
		
<script lang="uts">
export default {
  data() {
	return {
	  isConnected: true, // 机器人连接状态
	  joystickPosition: { x: 0, y: 0 }, // 摇杆位置
	  isDragging: false ,// 是否正在拖动摇杆
	  dPadX: 0,       // 右侧滑块X坐标
	  dPadY: 0,       // 右侧滑块Y坐标
	  dPadCenter: { x: 0, y: 0 }, // 十字区域中心点
	  dPadRadius: 0,  // 十字区域有效半径
	  isDPadDragging: false // 是否正在拖动右侧滑块
	};
  },
  onLoad() {
	// 页面加载时检查连接状态
	this.checkConnectionStatus();
  },
  methods: {
	// 检查机器人连接状态
	checkConnectionStatus() {
	  // 实际项目中这里会有真实的连接检测逻辑
	  setInterval(() => {
		// 模拟随机断开连接（实际项目中移除）
		// this.isConnected = Math.random() > 0.1;
	  }, 5000);
	},
	
	
	// 紧急停止
		emergencyStop() {
		  uni.showModal({
			title: '紧急停止',
			content: '确定要停止机器人所有动作吗？',
			confirmText: '停止',
			cancelText: '取消',
			success: (res) => {
			  if (res.confirm) {
				uni.showToast({ title: '已停止', icon: 'success' });
				// 实际停止逻辑
			  }
			}
		  });
		},
		
		// 摇杆触摸开始
		startJoystick(e) {
		  this.isDragging = true;
		  this.updateJoystickPosition(e);
		},
		
		// 摇杆触摸移动
		moveJoystick(e) {
		  if (this.isDragging) {
			this.updateJoystickPosition(e);
		  }
		},
		
		// 摇杆触摸结束
		endJoystick() {
		  this.isDragging = false;
		  // 重置摇杆位置
		  this.joystickPosition = { x: 0, y: 0 };
		  // 发送停止指令
		},
		
		// 更新摇杆位置并发送指令
		updateJoystickPosition(e) {
		  // 实际项目中计算摇杆位置并发送控制指令
		  const container = uni.createSelectorQuery().select('.joystick-container');
		  container.fields({ size: true, rect: true }, (data) => {
			// 计算相对位置逻辑
			const centerX = data.left + data.width / 2;
			const centerY = data.top + data.height / 2;
			const touchX = e.touches[0].clientX;
			const touchY = e.touches[0].clientY;
			
			// 计算偏移量并限制在容器内
			// 发送控制指令到机器人
		  }).exec();
		},
		
		// 右侧十字滑块触摸开始
		  startDPad(e) {
		    this.isDPadDragging = true;
		    // 获取十字容器的中心点和半径（仅首次触发时计算）
		    if (this.dPadRadius === 0) {
		      const container = uni.createSelectorQuery().select('.d-pad-container');
		      container.fields({ size: true, rect: true }, (data) => {
		        this.dPadCenter = {
		          x: data.width / 2,
		          y: data.height / 2
		        };
		        this.dPadRadius = data.width / 2 - 30; // 滑块活动半径（减去滑块自身一半大小）
		      }).exec();
		    }
		    this.moveDPad(e);
		  },
		  
		  // 右侧十字滑块触摸移动
		  moveDPad(e) {
		    if (!this.isDPadDragging) return;
		    
		    // 计算触摸位置相对中心点的偏移
		    const touchX = e.touches[0].clientX;
		    const touchY = e.touches[0].clientY;
		    const container = uni.createSelectorQuery().select('.d-pad-container');
		    
		    container.fields({ rect: true }, (data) => {
		      const relativeX = touchX - data.left - this.dPadCenter.x;
		      const relativeY = touchY - data.top - this.dPadCenter.y;
		      
		      // 限制滑块在十字区域内（不超过半径）
		      const distance = Math.sqrt(relativeX * relativeX + relativeY * relativeY);
		      if (distance > this.dPadRadius) {
		        // 超出范围时按比例缩放
		        this.dPadX = (relativeX / distance) * this.dPadRadius;
		        this.dPadY = (relativeY / distance) * this.dPadRadius;
		      } else {
		        this.dPadX = relativeX;
		        this.dPadY = relativeY;
		      }
		      
		      // 发送方向控制指令（根据X/Y偏移判断方向）
		      this.sendDirectionCommand(this.dPadX, this.dPadY);
		    }).exec();
		  },
		  
		  // 右侧十字滑块触摸结束
		  endDPad() {
		    this.isDPadDragging = false;
		    // 重置滑块位置到中心
		    this.dPadX = 0;
		    this.dPadY = 0;
		    // 发送停止指令
		    this.sendDirectionCommand(0, 0);
		  },
		  
		  // 根据X/Y偏移判断方向并发送指令
		  sendDirectionCommand(x, y) {
		    if (!this.isConnected) return;
		    
		    // 定义阈值（避免轻微触摸触发）
		    const threshold = 20;
		    let direction = '';
		    
		    if (y < -threshold) direction = '前';
		    else if (y > threshold) direction = '后';
		    else if (x < -threshold) direction = '左';
		    else if (x > threshold) direction = '右';
		    else direction = '停';
		    
		    if (direction !== '停') {
		      uni.showToast({ title: `向${direction}移动`, icon: 'none', duration: 100 });
		    }
		  },
	  }
	};
	
</script>
	
	
	
<style scoped>
.control-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #1a1a1a;
  color: #ffffff;
  overflow: hidden;
}

/* 顶部状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  font-size: 28rpx;
}

.connection-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.1);
}

.connection-status.connected {
  color: #34c759; /* 苹果绿色 */
}


/* 控制区域 */
.controls-area {
  display: flex;
  justify-content: space-between;
  padding: 40rpx 60rpx 20rpx;
  box-sizing: border-box;
  height: 360rpx;
}

/* 左侧圆形摇杆容器 */
.left-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
}

.joystick-container {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.joystick {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  touch-action: none;
}

/* 右侧十字控制容器 */
.right-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
}

/* 十字形容器（可触摸区域） */
.d-pad-container {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* 十字形背景线条 */
.d-pad-bg {
  width: 100%;
  height: 100%;
  position: relative;
}

.d-pad-line {
  background-color: rgba(255, 255, 255, 0.2);
  position: absolute;
  border-radius: 2rpx;
}

/* 垂直中线 */
.vertical {
  width: 4rpx;
  height: 120rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 水平中线 */
.horizontal {
  width: 120rpx;
  height: 4rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 可滑动的圆形滑块 */
.d-pad-joystick {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%); /* 初始位置在中心 */
  touch-action: none;
  transition: transform 0.1s ease-out;
}

/* 快捷功能按钮 */
.quick-actions {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 20rpx 0 40rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
		
</style>
	
