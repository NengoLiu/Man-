@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.control-container.data-v-00a60067 {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #1a1a1a;
  color: #ffffff;
  overflow: hidden;
}

/* 顶部状态栏 */
.status-bar.data-v-00a60067 {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: rgba(0, 0, 0, 0.7);
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
  font-size: 28rpx;
}
.connection-status.data-v-00a60067 {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.1);
}
.connection-status.connected.data-v-00a60067 {
  color: #34c759; /* 苹果绿色 */
}


/* 控制区域 */
.controls-area.data-v-00a60067 {
  display: flex;
  justify-content: space-between;
  padding: 40rpx 60rpx 20rpx;
  box-sizing: border-box;
  height: 360rpx;
}

/* 左侧圆形摇杆容器 */
.left-control.data-v-00a60067 {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
}
.joystick-container.data-v-00a60067 {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.joystick.data-v-00a60067 {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  touch-action: none;
}

/* 右侧十字控制容器 */
.right-control.data-v-00a60067 {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
}

/* 十字形容器（可触摸区域） */
.d-pad-container.data-v-00a60067 {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* 十字形背景线条 */
.d-pad-bg.data-v-00a60067 {
  width: 100%;
  height: 100%;
  position: relative;
}
.d-pad-line.data-v-00a60067 {
  background-color: rgba(255, 255, 255, 0.2);
  position: absolute;
  border-radius: 2rpx;
}

/* 垂直中线 */
.vertical.data-v-00a60067 {
  width: 4rpx;
  height: 120rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 水平中线 */
.horizontal.data-v-00a60067 {
  width: 120rpx;
  height: 4rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 可滑动的圆形滑块 */
.d-pad-joystick.data-v-00a60067 {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%); /* 初始位置在中心 */
  touch-action: none;
  transition: transform 0.1s ease-out;
}

/* 快捷功能按钮 */
.quick-actions.data-v-00a60067 {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 20rpx 0 40rpx;
}
.action-btn.data-v-00a60067 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.1);
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}
.action-btn.data-v-00a60067:active {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}
.action-icon.data-v-00a60067 {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.action-text.data-v-00a60067 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
		
