@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

/* 基础容器 - 横屏布局 */
.login-container.data-v-27a30816 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  background-color: #f5f7fa;
  box-sizing: border-box;
}

/* 背景装饰 */
.bg-decoration.data-v-27a30816 {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 20% 30%, rgba(0, 122, 255, 0.1) 0%, transparent 50%),
              radial-gradient(circle at 80% 70%, rgba(0, 122, 255, 0.1) 0%, transparent 50%);
  z-index: 0;
}

/* 登录卡片 */
.login-card.data-v-27a30816 {
  width: 100%;
  max-width: 800rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  z-index: 1;
}

/* 标题区域 */
.login-header.data-v-27a30816 {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}
.logo.data-v-27a30816 {
  margin-bottom: 30rpx;
  width: 600rpx;
  height: 120rpx;
  background-color: #e8f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-text.data-v-27a30816 {
  font-size: 60rpx;
  color: #007aff;
}
.subtitle.data-v-27a30816 {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}
.title.data-v-27a30816 {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

/* 表单区域 */
.login-form.data-v-27a30816 {
  margin-bottom: 60rpx;
}
.centered-form.data-v-27a30816 {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.form-group.data-v-27a30816 {
  display: flex;
  align-items: center;
  border: 1px solid #eee;
  padding: 25rpx 20rpx;
  margin-bottom: 20rpx;
  width: 100%;
  max-width: 600rpx;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

/* 输入框获得焦点时的发光效果 */
.form-group.data-v-27a30816:focus-within {
  border-color: #007aff;
  box-shadow: 0 0 0 2px rgba(0, 122, 255, 0.2);
}
.input-symbol.data-v-27a30816 {
  font-size: 30rpx;
  margin-right: 20rpx;
  color: #666;
}
.form-input.data-v-27a30816 {
  flex: 1;
  font-size: 30rpx;
  height: 40rpx;
  padding: 0;
  margin: 0;
  border: none;
  outline: none;
}
.form-input.data-v-27a30816::-webkit-input-placeholder {
  color: rgba(102, 102, 102, 0.6); /* 半透明提示文字 */
}
.form-input.data-v-27a30816::placeholder {
  color: rgba(102, 102, 102, 0.6); /* 半透明提示文字 */
}
.form-picker.data-v-27a30816 {
  flex: 1;
  cursor: pointer; /* 显示手型光标，提示可点击 */
}
.picker-display.data-v-27a30816 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #333;
  width: 100%;
}
.picker-arrow.data-v-27a30816 {
  font-size: 24rpx;
  color: #007aff;
  padding: 10rpx;
}

/* 连接状态 */
.connection-status.data-v-27a30816 {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 15rpx 0;
  font-size: 26rpx;
  width: 100%;
  max-width: 600rpx;
}
.status-symbol.data-v-27a30816 {
  margin-right: 10rpx;
  font-size: 20rpx;
}
.status-text.data-v-27a30816 {
  color: #666;
}
.connected .status-text.data-v-27a30816 {
  color: #00b42a;
}

/* 按钮区域 */
.login-actions.data-v-27a30816 {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  align-items: center;
}
.login-btn.data-v-27a30816 {
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  border-radius: 45rpx;
  width: 100%;
  max-width: 600rpx;
}

/* 链接区域 */
.link-group.data-v-27a30816 {
  margin-top: 20rpx;
  display: flex;
  gap: 40rpx;
}
.centered-links.data-v-27a30816 {
  justify-content: center;
  width: 100%;
}
.link-text.data-v-27a30816 {
  font-size: 28rpx;
  color: #007aff;
  text-decoration: underline;
}

/* 底部信息 */
.footer.data-v-27a30816 {
  margin-top: 50rpx;
  z-index: 1;
}
.footer-text.data-v-27a30816 {
  font-size: 24rpx;
  color: #999;
}
