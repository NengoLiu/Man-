<template>
  <view class="login-container">
    <!-- 背景装饰和天体动画 -->
    <view class="bg-decoration">
      <!-- 初始爆炸点 -->
      <view class="explosion-point" :class="{ exploded: hasExploded }"></view>
      
      <!-- 天体 -->
      <view 
        v-for="(celestial, index) in celestialBodies" 
        :key="index"
        class="celestial-body"
        :style="celestial.style"
      ></view>
    </view>
    
    <!-- 登录卡片 -->
    <view class="login-card">
      <!-- 标题区域 -->
      <view class="login-header">
        <view class="logo">
          <text class="logo-text">🤖</text>
        </view>
        <text class="subtitle">欢迎使用机器人控制中心</text>
        <text class="title">请登录以继续操作！</text>
      </view>
      
      <!-- 表单区域 -->
      <view class="login-form centered-form">
        <!-- 用户名输入 -->
        <view class="form-group">
          <text class="input-symbol">👤</text>
          <input 
            v-model="username" 
            placeholder="用户名" 
            class="form-input"
          />
        </view>
        
        <!-- 密码输入 -->
        <view class="form-group">
          <text class="input-symbol">🔒</text>
          <input 
            v-model="password" 
            type="password" 
            placeholder="密码" 
            class="form-input"
          />
        </view>
        
        <!-- 机器人网络选择 -->
        <view class="form-group">
          <text class="input-symbol">📶</text>
          <view class="form-picker" @click="openWifiSettings">
            <view class="picker-display">
              <text>
                {{ currentConnectedSsid || '点击选择机器人网络' }}
              </text>
              <text class="picker-arrow">→</text>
            </view>
          </view>
        </view>
        
        <!-- 连接状态显示 -->
        <view class="connection-status" :class="{ connected: isConnected }">
          <text 
            class="status-symbol"
            :style="{ color: isConnected ? '#00b42a' : '#ff4d4f' }"
          >●</text>
          <text class="status-text">
            {{ isConnected ? `已连接: ${currentConnectedSsid}` : '未连接到机器人网络' }}
          </text>
        </view>
      </view>
      
      <!-- 按钮区域 -->
      <view class="login-actions">
        <button 
          type="primary" 
          class="login-btn"
          @click="handleLogin"
          :loading="isLoading"
        >
          登录
        </button>
        
        <!-- 链接区域 -->
        <view class="link-group centered-links">
          <text class="link-text" @click="handleForgot">忘记密码?</text>
          <text class="link-text" @click="handleRegister">注册账号</text>
        </view>
      </view>
    </view>
    
    <!-- 底部信息 -->
    <view class="footer">
      <text class="footer-text">机器人控制中心 v1.0.0</text>
    </view>
  </view>
</template>

<script>
// plus变量在uni-app环境中由系统提供

export default {
  data() {
    return {
      username: '',
      password: '',
      currentConnectedSsid: '', // 当前已连接的网络名称
      isConnected: false, // 是否连接到机器人网络
      isLoading: false,
      connectionCheckInterval: null, // 网络检查定时器
      hasExploded: false,
      celestialBodies: []
    };
  },
  
  onLoad() {
    // 启动天体动画
    this.startAnimation();
    
    // 页面加载时检查当前连接状态
    this.checkCurrentConnection();
    
    // 监听网络变化（每3秒检查一次）
    this.connectionCheckInterval = setInterval(() => {
      this.checkCurrentConnection();
    }, 3000);
  },
  
  onUnload() {
    // 页面卸载时清除定时器
    if (this.connectionCheckInterval) {
      clearInterval(this.connectionCheckInterval);
    }
  },
  
  methods: {
    startAnimation() {
      // 延迟1秒后开始爆炸动画
      setTimeout(() => {
        this.hasExploded = true;
        this.createCelestialBodies();
      }, 1000);
    },
    
    createCelestialBodies() {
      const colors = [
        '#00d4ff', '#ff6b6b', '#4ecdc4', '#45b7d1', 
        '#96ceb4', '#feca57', '#ff9ff3', '#a29bfe',
        '#fd79a8', '#6c5ce7', '#00b894', '#e17055'
      ];
      
      const bodies = [];
      
      // 创建30个天体
      for (let i = 0; i < 30; i++) {
        const size = Math.random() * 15 + 6; // 6-21rpx (更小一些)
        const color = colors[Math.floor(Math.random() * colors.length)];
        const angle = (Math.PI * 2 * i) / 30 + Math.random() * 0.5;
        const distance = Math.random() * 200 + 80; // 80-280rpx (更紧凑)
        const animationDelay = Math.random() * 2;
        const animationDuration = Math.random() * 10 + 15;
        
        const startX = 375; // 屏幕中心
        const startY = 150; // 动画区域中心 (降低一些)
        const endX = startX + Math.cos(angle) * distance;
        const endY = startY + Math.sin(angle) * distance;
        
        bodies.push({
          style: {
            width: `${size}rpx`,
            height: `${size}rpx`,
            backgroundColor: color,
            left: `${startX}rpx`,
            top: `${startY}rpx`,
            animationDelay: `${animationDelay}s`,
            animationDuration: `${animationDuration}s`,
            '--end-x': `${endX}rpx`,
            '--end-y': `${endY}rpx`,
            boxShadow: `0 0 ${size/2}rpx ${color}60`
          }
        });
      }
      
      this.celestialBodies = bodies;
    },
    
    // 打开系统WLAN设置界面
    openWifiSettings() {
      if (typeof plus === 'undefined') {
        uni.showToast({ title: '请在App环境中使用', icon: 'none' });
        return;
      }
      
      // 调用系统API打开WLAN设置
      plus.android.requestPermissions(
        ["android.permission.ACCESS_WIFI_STATE"],
        () => {
          try {
            const Intent = plus.android.importClass("android.content.Intent");
            const Settings = plus.android.importClass("android.provider.Settings");
            const intent = new Intent(Settings.ACTION_WIFI_SETTINGS);
            const main = plus.android.runtimeMainActivity();
            main.startActivity(intent);
          } catch (e) {
            const isPermissionError = 
              (e.message && (e.message.includes('权限') || e.message.includes('permission') || e.message.includes('denied'))) ||
              e.code === 1 || e.code === 1001 || e.code === 'PERMISSION_DENIED';
            
            if (isPermissionError) {
              uni.showToast({ title: '需要权限才能打开设置', icon: 'none', duration: 2000 });
            } else {
              uni.showToast({ title: '无法打开Wi-Fi设置', icon: 'none', duration: 2000 });
            }
            console.error('打开Wi-Fi设置失败:', e);
          }
        },
        (err) => {
          uni.showToast({ title: '请授予权限以打开Wi-Fi设置', icon: 'none', duration: 2000 });
          console.warn('权限请求被拒绝:', err);
        }
      );
    },
    
    // 检查当前已连接的网络
    checkCurrentConnection() {
      if (typeof plus === 'undefined') return;
      
      try {
        // 获取当前连接的Wi-Fi信息
        const wifiManager = plus.android.runtimeMainActivity().getSystemService("wifi");
        const info = wifiManager.getConnectionInfo();
        if (info) {
          // 获取SSID并去除引号
          let ssid = info.getSSID();
          if (ssid && ssid.startsWith('"') && ssid.endsWith('"')) {
            ssid = ssid.substring(1, ssid.length - 1);
          }
          this.currentConnectedSsid = ssid || '';
          // 判断是否为机器人网络（以"ROBOT-"开头）
          this.isConnected = ssid && (ssid.startsWith('ROBOT-') || ssid.startsWith('QIDIAN-'));
        }
      } catch (e) {
        console.log('检查网络连接失败:', e);
      }
    },
    
    // 处理登录
    handleLogin() {
      if (!this.username.trim()) {
        return uni.showToast({ title: '请输入用户名', icon: 'none' });
      }
      
      if (!this.password.trim()) {
        return uni.showToast({ title: '请输入密码', icon: 'none' });
      }
      
      if (!this.isConnected) {
        return uni.showToast({ title: '请先连接机器人网络', icon: 'none' });
      }
      
      this.isLoading = true;
      
      // 模拟登录过程
      setTimeout(() => {
        this.isLoading = false;
        uni.showToast({ title: '登录成功', icon: 'success' });
        
        // 登录成功后触发事件
        setTimeout(() => {
          this.$emit('loginSuccess');
        }, 500);
      }, 1000);
    },
    
    // 忘记密码
    handleForgot() {
      uni.showToast({ title: '忘记密码功能待实现', icon: 'none' });
    },
    
    // 注册账号
    handleRegister() {
      uni.showToast({ title: '注册功能待实现', icon: 'none' });
    }
  }
};
</script>

<style scoped>
