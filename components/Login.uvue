    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
  }
  10% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    left: var(--end-x);
    top: var(--end-y);
    opacity: 0.4;
    transform: translate(-50%, -50%) scale(1) rotate(360deg);
  }
}

